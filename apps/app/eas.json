{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "image": "sdk-58" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "image": "sdk-58" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": { "image": "sdk-58" }
    },
    "production-dev": {
      "extends": "production",
      "environment": "development",
      "channel": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6777101805"
      }
    },
    "production-dev": {
      "ios": {
        "ascAppId": "6777101805"
      }
    }
  }
}
