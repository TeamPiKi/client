{
  "expo": {
    "name": "PiKi",
    "slug": "piki",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "piki",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "bundleIdentifier": "day.no30s.piki",
      "entitlements": {
        "aps-environment": "development", // NOTE: 배포할때 'production'으로 변경
        "com.apple.security.application-groups": ["group.day.no30s.piki"],
        "keychain-access-groups": ["$(AppIdentifierPrefix)group.day.no30s.piki"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "AppGroup": "group.day.no30s.piki",
        "AppGroupIdentifier": "group.day.no30s.piki",
        "UIBackgroundModes": ["remote-notification"],
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "kakaotalk",
          "kakao326734abdf8de5c7e090a2fc72e1dce6"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ]
      },
      "usesNonExemptEncryption": false
    },
    "android": {
      "package": "day.no30s.piki",
      "adaptiveIcon": {
        "backgroundColor": "#A2DEFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "326734abdf8de5c7e090a2fc72e1dce6"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.978975594396-mo5b39fe8fqfuukqkf42p63tlqkc4785"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#A2DEFF",
          "dark": {
            "backgroundColor": "#A2DEFF"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "상품 사진을 가져오고 싶어요."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*", "image/*"],
          "androidMultiIntentFilters": ["image/*"]
        }
      ],
      [
        "expo-share-extension",
        {
          "backgroundColor": {
            "red": 255,
            "green": 255,
            "blue": 255,
            "alpha": 0
          },
          "activationRules": [
            {
              "type": "image",
              "max": 1
            },
            {
              "type": "text"
            },
            {
              "type": "url",
              "max": 1
            }
          ],
          "excludedPackages": [
            "expo-dev-client",
            "expo-splash-screen",
            "expo-updates",
            "expo-share-intent"
          ]
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging", "RNFBAnalytics"],
            "deploymentTarget": "16.4"
          },
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          }
        }
      ],
      "./plugins/withShareExtensionKeychain.js",
      [
        "./plugins/withKakaoLoginConfig.js",
        {
          "nativeAppKey": "326734abdf8de5c7e090a2fc72e1dce6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "576644de-9cba-4457-82a2-562f7dd89d92"
      }
    },
    "owner": "no-30s"
  }
}
