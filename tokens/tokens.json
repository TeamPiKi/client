{
  "$extensions": {
    "figma-git-sync": {
      "version": 1,
      "collections": {
        "Atomic": {
          "modes": [
            "core"
          ],
          "defaultMode": "core"
        },
        "Sementic": {
          "modes": [
            "semantic"
          ],
          "defaultMode": "semantic"
        },
        "Typography": {
          "modes": [
            "Mode 1"
          ],
          "defaultMode": "Mode 1"
        },
        "Shape": {
          "modes": [
            "Mode 1.tokens 2"
          ],
          "defaultMode": "Mode 1.tokens 2"
        },
        "Text Styles": {
          "modes": [
            "default"
          ],
          "defaultMode": "default"
        },
        "Effect Styles": {
          "modes": [
            "default"
          ],
          "defaultMode": "default"
        }
      }
    }
  },
  "Atomic": {
    "Base": {
      "50": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "950": {
        "$type": "color",
        "$value": "#000000"
      }
    }
  },
  "Sementic": {
    "bg": {
      "accent": {
        "$type": "color",
        "$value": "{Atomic.Sky blue.500}"
      },
      "warning": {
        "$type": "color",
        "$value": "{Atomic.Yellow.50}"
      },
      "error": {
        "$type": "color",
        "$value": "{Atomic.Red.50}"
      },
      "success": {
        "$type": "color",
        "$value": "{Atomic.Green.50}"
      },
      "informative": {
        "$type": "color",
        "$value": "{Atomic.Blue.50}"
      },
      "neutral": {
        "primary": {
          "$type": "color",
          "$value": "{Atomic.Gray.900}",
          "$description": "앱 메인 배경"
        },
        "secondary": {
          "$type": "color",
          "$value": "{Atomic.Gray.800}",
          "$description": "카드·섹션 배경"
        },
        "tertiary": {
          "$type": "color",
          "$value": "{Atomic.Gray.75}",
          "$description": "한 단계 더 깊은 배경"
        }
      },
      "layer": {
        "default": {
          "$type": "color",
          "$value": "{Atomic.Base.50}",
          "$description": "앱 메인 배경"
        },
        "basement": {
          "$type": "color",
          "$value": "{Atomic.Gray.50}",
          "$description": "카드·섹션 배경"
        },
        "floating": {
          "$type": "color",
          "$value": "{Atomic.Base.50}",
          "$description": "한 단계 더 깊은 배경"
        },
        "overlay-40": {
          "$type": "color",
          "$value": "#00000066",
          "$description": "한 단계 더 깊은 배경"
        },
        "overlay-20": {
          "$type": "color",
          "$value": "#00000033",
          "$description": "한 단계 더 깊은 배경"
        },
        "overlay-12": {
          "$type": "color",
          "$value": "#0000001f",
          "$description": "한 단계 더 깊은 배경"
        },
        "overlay-8": {
          "$type": "color",
          "$value": "#00000014",
          "$description": "한 단계 더 깊은 배경"
        },
        "overlay-4": {
          "$type": "color",
          "$value": "#0000000a",
          "$description": "한 단계 더 깊은 배경"
        }
      }
    },
    "text": {
      "accent": {
        "$type": "color",
        "$value": "{Atomic.Sky blue.600}"
      },
      "warning": {
        "$type": "color",
        "$value": "{Atomic.Yellow.900}"
      },
      "error": {
        "$type": "color",
        "$value": "{Atomic.Red.600}"
      },
      "success": {
        "$type": "color",
        "$value": "{Atomic.Green.600}"
      },
      "informative": {
        "$type": "color",
        "$value": "{Atomic.Blue.600}"
      },
      "neutral": {
        "primary": {
          "$type": "color",
          "$value": "{Atomic.Gray.900}",
          "$description": "본문·기본 텍스트"
        },
        "secondary": {
          "$type": "color",
          "$value": "{Atomic.Gray.600}",
          "$description": "본문·기본 텍스트"
        },
        "tertiary": {
          "$type": "color",
          "$value": "{Atomic.Gray.300}",
          "$description": "본문·기본 텍스트"
        },
        "inverse": {
          "$type": "color",
          "$value": "{Atomic.Base.50}",
          "$description": "본문·기본 텍스트"
        }
      }
    },
    "border": {
      "accent": {
        "$type": "color",
        "$value": "{Atomic.Sky blue.400 •}"
      },
      "warning": {
        "$type": "color",
        "$value": "{Atomic.Yellow.400 •}"
      },
      "error": {
        "$type": "color",
        "$value": "{Atomic.Red.400}"
      },
      "success": {
        "$type": "color",
        "$value": "{Atomic.Green.400}"
      },
      "informative": {
        "$type": "color",
        "$value": "{Atomic.Blue.400}"
      },
      "neutral": {
        "primary": {
          "$type": "color",
          "$value": "{Atomic.Gray.700}",
          "$description": "카드·인풋 보더"
        },
        "secondary": {
          "$type": "color",
          "$value": "{Atomic.Gray.500}",
          "$description": "카드·인풋 보더"
        },
        "tertiary": {
          "$type": "color",
          "$value": "{Atomic.Gray.300}",
          "$description": "카드·인풋 보더"
        },
        "muted": {
          "$type": "color",
          "$value": "{Atomic.Gray.75}",
          "$description": "카드·인풋 보더"
        }
      }
    },
    "icon": {
      "accent": {
        "$type": "color",
        "$value": "{Atomic.Sky blue.500}",
        "$description": "카드·인풋 보더"
      },
      "warning": {
        "$type": "color",
        "$value": "{Atomic.Yellow.500}",
        "$description": "카드·인풋 보더"
      },
      "error": {
        "$type": "color",
        "$value": "{Atomic.Red.300}",
        "$description": "카드·인풋 보더"
      },
      "success": {
        "$type": "color",
        "$value": "{Atomic.Green.400}",
        "$description": "카드·인풋 보더"
      },
      "informative": {
        "$type": "color",
        "$value": "{Atomic.Blue.600}",
        "$description": "카드·인풋 보더"
      },
      "neutral": {
        "primary": {
          "$type": "color",
          "$value": "{Atomic.Gray.600}",
          "$description": "카드·인풋 보더"
        },
        "secondary": {
          "$type": "color",
          "$value": "{Atomic.Gray.300}",
          "$description": "카드·인풋 보더"
        },
        "inverse": {
          "$type": "color",
          "$value": "{Atomic.Base.50}",
          "$description": "카드·인풋 보더"
        }
      }
    }
  },
  "Typography": {
    "weight": {
      "regular": {
        "$type": "string",
        "$value": "regular"
      },
      "medium": {
        "$type": "string",
        "$value": "medium"
      },
      "semibold": {
        "$type": "string",
        "$value": "semibold"
      },
      "bold": {
        "$type": "string",
        "$value": "bold"
      }
    },
    "size": {
      "title": {
        "1": {
          "$type": "number",
          "$value": 24
        }
      },
      "heading": {
        "1": {
          "$type": "number",
          "$value": 20
        },
        "2": {
          "$type": "number",
          "$value": 18
        }
      },
      "body": {
        "1": {
          "$type": "number",
          "$value": 16
        },
        "2": {
          "$type": "number",
          "$value": 14
        }
      },
      "caption": {
        "1": {
          "$type": "number",
          "$value": 12
        }
      }
    },
    "line-height": {
      "title": {
        "1": {
          "$type": "number",
          "$value": 32
        }
      },
      "heading": {
        "1": {
          "$type": "number",
          "$value": 28
        },
        "2": {
          "$type": "number",
          "$value": 26
        }
      },
      "body": {
        "1": {
          "$type": "number",
          "$value": 22
        },
        "2": {
          "$type": "number",
          "$value": 20
        }
      },
      "caption": {
        "1": {
          "$type": "number",
          "$value": 18
        }
      }
    },
    "letter-spacing": {
      "letter-spacing": {
        "$type": "number",
        "$value": -0.6
      },
      "letter-spacing 2": {
        "$type": "number",
        "$value": -0.4
      }
    },
    "Text": {
      "$type": "string",
      "$value": "String value"
    }
  },
  "Shape": {
    "Radius": {
      "Radius-r1": {
        "$type": "number",
        "$value": 4
      },
      "Radius-r2": {
        "$type": "number",
        "$value": 8
      },
      "Radius-r3": {
        "$type": "number",
        "$value": 12
      },
      "Radius-r4": {
        "$type": "number",
        "$value": 16
      },
      "Radius-r5": {
        "$type": "number",
        "$value": 20
      },
      "Radius-r6": {
        "$type": "number",
        "$value": 24
      },
      "Radius-r7": {
        "$type": "number",
        "$value": 28
      }
    },
    "Spacing": {
      "Spacing -x1": {
        "$type": "number",
        "$value": 4
      },
      "Spacing -x2": {
        "$type": "number",
        "$value": 8
      },
      "Spacing -x3": {
        "$type": "number",
        "$value": 12
      },
      "Spacing -x4": {
        "$type": "number",
        "$value": 16
      },
      "Spacing -x5": {
        "$type": "number",
        "$value": 20
      },
      "Spacing -x6": {
        "$type": "number",
        "$value": 24
      },
      "Spacing -x7": {
        "$type": "number",
        "$value": 28
      },
      "Spacing -x8": {
        "$type": "number",
        "$value": 32
      },
      "Spacing -x9": {
        "$type": "number",
        "$value": 36
      }
    }
  },
  "Text Styles": {
    "Title 1": {
      "bold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 700,
          "fontSize": "{Typography.size.title.1}",
          "lineHeight": "{Typography.line-height.title.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "최상단 헤더"
      }
    },
    "Heading 1": {
      "bold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 700,
          "fontSize": "{Typography.size.heading.1}",
          "lineHeight": "{Typography.line-height.heading.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "서브 타이틀, 바텀시트 타이틀"
      },
      "semibold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 600,
          "fontSize": "{Typography.size.heading.1}",
          "lineHeight": "{Typography.line-height.heading.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "서브 타이틀, 바텀시트 타이틀"
      }
    },
    "Heading 2": {
      "semibold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 600,
          "fontSize": "{Typography.size.heading.2}",
          "lineHeight": "{Typography.line-height.heading.2}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "인풋 필드 레이블"
      },
      "medium": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 500,
          "fontSize": "{Typography.size.heading.2}",
          "lineHeight": "{Typography.line-height.heading.2}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "서브 타이틀"
      }
    },
    "Body 1": {
      "bold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 700,
          "fontSize": "{Typography.size.body.1}",
          "lineHeight": "{Typography.line-height.body.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "아이템 타이틀(카드)"
      },
      "semibold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 600,
          "fontSize": "{Typography.size.body.1}",
          "lineHeight": "{Typography.line-height.body.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "CTA 버튼 텍스트, 상품 링크 카드 헤더"
      },
      "medium": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 500,
          "fontSize": "{Typography.size.body.1}",
          "lineHeight": "{Typography.line-height.body.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "Input text"
      }
    },
    "Body 2": {
      "Semibold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 600,
          "fontSize": "{Typography.size.body.2}",
          "lineHeight": "{Typography.line-height.body.2}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "상품명, 아이템 타이틀 등 리스트 카드 내 주요 텍스트"
      },
      "medium": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 500,
          "fontSize": "{Typography.size.body.2}",
          "lineHeight": "{Typography.line-height.body.2}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "액션텍스트, 로딩 텍스트"
      },
      "regular": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 400,
          "fontSize": "{Typography.size.body.2}",
          "lineHeight": "{Typography.line-height.body.2}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing}"
        },
        "$description": "help message"
      }
    },
    "Caption 1": {
      "semibold": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 600,
          "fontSize": "{Typography.size.caption.1}",
          "lineHeight": "{Typography.line-height.caption.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing 2}"
        },
        "$description": "badge 내부 텍스트"
      },
      "regular": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Pretendard",
          "fontWeight": 400,
          "fontSize": "{Typography.size.caption.1}",
          "lineHeight": "{Typography.line-height.caption.1}",
          "letterSpacing": "{Typography.letter-spacing.letter-spacing 2}"
        },
        "$description": "액션과 무관한 보조 설명 텍스트"
      }
    }
  },
  "Effect Styles": {
    "Image card shadow": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000029",
          "offsetX": 0,
          "offsetY": 0,
          "blur": 8,
          "spread": 0,
          "inset": false
        }
      ],
      "$description": "이미지 카드에 사용"
    },
    "Tournament card shadow": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0000001a",
          "offsetX": 0,
          "offsetY": 1,
          "blur": 8,
          "spread": 0,
          "inset": false
        }
      ],
      "$description": "토너먼트 카드에 사용"
    }
  }
}
